{
  "root": true,
  "extends": ["eslint:recommended", "next/core-web-vitals", "prettier"],
  "overrides": [
    {
      "files": ["tests/**/*.js", "jest.setup.js"],
      "plugins": ["jest"],
      "extends": ["plugin:jest/recommended"],
      "env": {
        "jest": true,
        "node": true
      }
    },
    {
      "files": ["jest.config.js"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["infra/**/*.js"],
      "env": {
        "node": true
      }
    }
  ]
}
